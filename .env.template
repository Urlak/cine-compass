# Ключ для api.kinopoisk.dev (демо-тариф: 200 запросов/сутки, бот @kinopoiskdev_bot)
KINOPOISK_API_KEY=

# Ключ Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Модель Gemini
LLM_MODEL=gemini-2.5-flash

# Пауза между запросами к kinopoisk.dev, секунд
ENRICH_INTERVAL=0.4

# Пакетная семантическая классификация (Этап 3): размер партии и лимит расходов.
# Лимит считается по факту usage.jsonl (prompt+thoughts+output, op=semantic_enrich);
# пустое значение = без лимита. Точное значение определить после первой партии.
SEMANTIC_ENRICHMENT_BATCH_SIZE=15
SEMANTIC_ENRICHMENT_MAX_TOKENS=
