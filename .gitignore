.venv/
__pycache__/
.env
.pytest_cache/
.DS_Store

# data игнорируется целиком, кроме кэшей: они зависят только от фильма
# (жанры/режиссёры/рейтинги/теги) и не содержат личных данных — истории
# просмотров, оценок и дат. Библиотеки и выводы пользователей остаются
# локальными и переносятся в облако вручную, если понадобится.
data/*
!data/caches/
